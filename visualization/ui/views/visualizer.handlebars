<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>Visualizer</title>
  <data id="static-visualization" value={{static}}></data>
  <data id="question-max" value="-1"></data>
  <meta id="parent-origin" content="{{parentOrigin}}">
  <script type="module" src="src/visualizer.js" charset="utf-8" defer></script>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"> </script>
</head>

<body id="body">
  <div id="wrapper" class={{role}}>
    <div id="help-window" hidden>
      <button id="close-help-window-button">X</button>
      <iframe height="90%" width="100%" src="/help.html"></iframe>
    </div>
    <div id="zoom-container" hidden>
      <button id="zoom-in" class="file-icon" data-tooltip="Zoom In">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>

      <button id="zoom-reset" class="file-icon" data-tooltip="Reset to Saved Zoom">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80"
            viewBox="0 0 24 24" fill="none" stroke="#000000"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 9V4h5"></path>
          <path d="M20 9V4h-5"></path>
          <path d="M4 15v5h5"></path>
          <path d="M20 15v5h-5"></path>
        </svg>
      </button>

      <button id="zoom-out" class="file-icon" data-tooltip="Zoom Out">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </div>
    <button id="editor-button" hidden>editor mode</button>
    <button id="participant-button" hidden>participant mode</button>
    <div id="uploader-container" hidden>
      <input type="file" id="svg-uploader" accept=".svg, .jpg, .jpeg, .png, .JPG, .JPEG, .PNG, image/jpeg, image/png, image/svg+xml" style="margin: 10px;" />
    </div>

    <div id="file-toolbar" hidden>
      <button class="file-icon" id="icon-save" data-tooltip="Save">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline>
        </svg>
      </button>
      <button class="file-icon" id="icon-import" data-tooltip="Import">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 9l-5 5-5-5M12 12.8V2.5"/>
        </svg>
      </button>
      <button class="file-icon" id="icon-export" data-tooltip="Export">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 15v4c0 1.1.9 2 2 2h14a2 2 0 0 0 2-2v-4M17 8l-5-5-5 5M12 4.2v10.3"/>
        </svg>
      </button>
      <button class="file-icon" id="icon-rotate-left" data-tooltip="Rotate Left">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38"/>
        </svg>
      </button>
      <button class="file-icon" id="icon-rotate-right" data-tooltip="Rotate Right">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38"/>
        </svg>
      </button>
    </div>
    
    <div id="button-header" hidden>
      <small id="save-status"></small>

      <div id="upload-progress-container" hidden>
        <div id="upload-progress-bar">
          <div id="upload-progress-fill"></div>
        </div>
        <small id="upload-progress-text"></small>
      </div>

      <div class="file dropdown" hidden>
        File
        <div class="dropdown-buttons file-buttons">
        </div>
      </div>

      <div id="options-dropdown" class="options dropdown" hidden>
        Options
        <div class="dropdown-buttons option-buttons">
        </div>
      </div>

      <div class="tools dropdown" hidden>
        Tools
        <div class="dropdown-buttons tool-buttons">
        </div>
      </div>

      <button id="help-button" hidden>?</button>

    </div>

    <div id="drop-zone-overlay" hidden>
      <div class="drop-zone-card">
        <p>Drop image here</p>
        <small>.svg, .png, .jpg</small>
      </div>
    </div>

    <div id="visual-container" data-svg-loaded="{{#if svg}}true{{else}}false{{/if}}">
      {{#if svg}}
      {{{svg}}}
      {{else}}
      <div id="svg-loading-spinner">
        <div class="spinner"></div>
        <p>Loading visualization...</p>
      </div>
      {{/if}}
    </div>
    
    <div id="tooltip-container" class="card" hidden>
      <div class="card-body">
        <div id="tooltip-setting" class="form-check" hidden>
          <input class="form-check-input" type="checkbox" value="" id="checkTooltip">
          <label class="form-check-label" for="checkTooltip">
            Details on Hover?
          </label>
        </div>
        <p id="tooltip-detail" class="card-text" style="margin-bottom: 0rem">No Information</p>
        <div class="input-group mb-3" id="groupTooltip" style="margin-top: 0.5rem" hidden>
          <input class="form-control" type="text" placeholder="Edit Label" id="controlTooltip">
          <button id="modifyButton" class="btn btn-outline-primary" type="button">
            Edit
          </button>
        </div>
      </div>
    </div>

    <!-- Popup for per-element dropdown questions (features/dropdownQuestions.js) -->
    <div id="dropdown-card" class="card shadow-sm" role="dialog" aria-label="Element question" hidden>
      <div class="card-body p-3">
        <div id="dropdown-editor" hidden>
          <label for="dropdown-question-input" class="form-label mb-2">Question for this element</label>
          <input id="dropdown-question-input" class="form-control mb-3" type="text">
          <!-- Same layout as the Question Choices editor in main/ui/views/editquestion.handlebars -->
          <h6 class="mb-2">Question Choices</h6>
          <div class="input-group mb-2">
            <button id="dropdown-add-answer" class="btn btn-primary" type="button">Add
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            </button>
            <input id="dropdown-answer-input" class="form-control" type="text" placeholder="Enter choice" aria-label="Enter choice">
          </div>
          <ul id="dropdown-answer-list" class="list-group"></ul>
          <p id="dropdown-editor-error" class="text-danger small mb-0 mt-2" hidden></p>
          <div class="d-flex flex-wrap gap-2 mt-3">
            <button id="dropdown-save" class="btn btn-primary" type="button">Save</button>
            <button id="dropdown-remove" class="btn btn-outline-danger" type="button">Remove question</button>
            <button id="dropdown-cancel" class="btn btn-outline-secondary" type="button">Cancel</button>
          </div>
        </div>
        <div id="dropdown-participant" hidden>
          <label id="dropdown-question-text" for="dropdown-answer-select" class="form-label mb-2"></label>
          <select id="dropdown-answer-select" class="form-select"></select>
        </div>
      </div>
    </div>
  </div>

</body>

</html>